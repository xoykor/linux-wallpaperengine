#!/usr/bin/env bash
set -euo pipefail

APPDIR="${APPDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
ENGINE_DIR="${APPDIR}/usr/lib/linux-wallpaperengine"
ENGINE_LIBRARY_PATH="${APPDIR}/usr/lib:${ENGINE_DIR}:${ENGINE_DIR}/lib:${ENGINE_DIR}/lib64"

for candidate in "${ENGINE_DIR}"/lib/* "${ENGINE_DIR}"/lib64/*; do
    [[ -d "${candidate}" ]] && ENGINE_LIBRARY_PATH+=":${candidate}"
done

export PATH="${ENGINE_DIR}:${PATH}"
export PYTHONPATH="${APPDIR}/usr/lib${PYTHONPATH:+:${PYTHONPATH}}"
export LINUX_WALLPAPERENGINE_LIBRARY_PATH="${ENGINE_LIBRARY_PATH}"
export PYTHONDONTWRITEBYTECODE=1
export LINUX_WALLPAPERENGINE_APPIMAGE=1
export LINUX_WALLPAPERENGINE_APPIMAGE_VERSION="@APPIMAGE_VERSION@"
export LINUX_WALLPAPERENGINE_APPIMAGE_PATH="${APPIMAGE:-}"
export LINUX_WALLPAPERENGINE_ICON_FILE="${APPDIR}/usr/share/icons/hicolor/scalable/apps/linux-wallpaperengine-app.svg"
export LINUX_WALLPAPERENGINE_RENDERER_PATH="${ENGINE_DIR}/linux-wallpaperengine"
# Render the large preview gallery on the GPU. GTK can fall back if Vulkan is
# unavailable; honor an explicit override for systems that need another backend.
export GSK_RENDERER="${GSK_RENDERER:-vulkan}"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    printf 'Usage: %s [--help]\nLaunch the Linux Wallpaper Engine desktop application.\n' "$(basename -- "$0")"
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    printf 'Linux Wallpaper Engine requires Python 3 and GTK 4 introspection (PyGObject).\n' >&2
    exit 1
fi

if ! python3 -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_version("GdkPixbuf", "2.0"); from gi.repository import Gtk, GdkPixbuf' >/dev/null 2>&1; then
    message='Install Python 3, PyGObject, GTK 4 and GdkPixbuf introspection to run this AppImage.'
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title='Linux Wallpaper Engine' --text="${message}" 2>/dev/null || true
    else
        printf '%s\n' "${message}" >&2
    fi
    exit 1
fi

if (($#)); then
    exec python3 -m wallpaper_engine_app "$@"
fi

# The previous AppImage releases shared one daemon socket. Stop those renderers
# before starting this version so an upgraded GUI cannot keep driving an old engine.
if ! python3 -c 'from wallpaper_engine_app.model import stop_previous_appimage_daemons; raise SystemExit(0 if stop_previous_appimage_daemons() else 1)'; then
    message='An older Wallpaper Engine AppImage renderer is still running. Close the older app and open this version again.'
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title='Linux Wallpaper Engine' --text="${message}" 2>/dev/null || true
    else
        printf '%s\n' "${message}" >&2
    fi
    exit 1
fi

socket_ready() {
    python3 -c 'from wallpaper_engine_app.model import SOCKET_FILE; import socket; client = socket.socket(socket.AF_UNIX); client.settimeout(0.3); client.connect(str(SOCKET_FILE)); client.close()' \
        >/dev/null 2>&1
}

wait_for_daemon() {
    python3 - <<'PY'
import json
import socket
import sys
import time

from wallpaper_engine_app.model import SOCKET_FILE

deadline = time.monotonic() + 45
while time.monotonic() < deadline:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.0)
            client.connect(str(SOCKET_FILE))
            client.sendall(b'{"command":"status"}\n')
            with client.makefile("rb") as reader:
                response = json.loads(reader.readline(1024 * 1024 + 1))
        if response.get("ok") is True and isinstance(response.get("status"), dict):
            sys.exit(0)
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    time.sleep(0.1)
sys.exit(1)
PY
}

# Reuse an existing user daemon. A new daemon must own a separate AppImage
# runtime: this window's runtime unmounts its AppDir when the GUI exits.
if ! socket_ready; then
    python3 - <<'PY'
import os
import subprocess
import sys

image = os.environ.get("APPIMAGE")
if image and os.path.isfile(image) and os.access(image, os.X_OK):
    command = [image, "--daemon"]
    environment = os.environ.copy()
    # The second runtime must select its own mount, not inherit this GUI's.
    for name in ("APPDIR", "PYTHONPATH", "LINUX_WALLPAPERENGINE_LIBRARY_PATH",
                 "LINUX_WALLPAPERENGINE_RENDERER_PATH"):
        environment.pop(name, None)
else:
    # Support launching an unpacked AppDir during development.
    command = [sys.executable, "-m", "wallpaper_engine_app", "--daemon"]
    environment = os.environ.copy()

subprocess.Popen(command, env=environment, stdin=subprocess.DEVNULL,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                 start_new_session=True, close_fds=True)
PY

    if ! wait_for_daemon; then
        printf 'The Wallpaper Engine daemon could not start.\n' >&2
        exit 1
    fi
elif ! wait_for_daemon; then
    printf 'The Wallpaper Engine daemon did not become ready.\n' >&2
    exit 1
fi

exec python3 -m wallpaper_engine_app
